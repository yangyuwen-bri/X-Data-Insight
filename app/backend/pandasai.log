highest_likes_query = """
SELECT 
    DATE(createdAt) AS date,
    SUM(likeCount) AS total_likes
FROM 
    table_f203a5441b6c3ad1e951964448975e22
GROUP BY 
    DATE(createdAt)
ORDER BY 
    total_likes DESC
LIMIT 1;
"""
highest_likes_data = execute_sql_query(highest_likes_query)
highest_likes_date = highest_likes_data['date'].iloc[0]
highest_likes_count = highest_likes_data['total_likes'].iloc[0]

# Query to find the tweet with the most likes on the highest likes date
most_liked_tweet_query = f"""
SELECT 
    text, 
    likeCount, 
    author.name AS author_name
