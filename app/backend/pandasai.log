import pandas as pd
import matplotlib.pyplot as plt

# Execute SQL query to get the like counts aggregated by date
sql_query = """
SELECT 
    DATE(createdAt) AS date,
    SUM(likeCount) AS total_likes
FROM 
    table_f203a5441b6c3ad1e951964448975e22
GROUP BY 
    DATE(createdAt)
ORDER BY 
    DATE(createdAt);
"""

# Fetch the data into a DataFrame
likes_data = execute_sql_query(sql_query)

# Plotting the trend of likes over time
plt.figure(figsize=(10, 5))
plt.plot(likes_data['date'], likes_data['total_likes'], marker='o')
plt.title('Likes Trend Over Time')
plt.xlabel('Date')
plt.ylabel('Total Likes')
plt.xticks(rotation=45)
plt.grid()
plt.tight_layout()

# Save the plot
plot_filename = 'likes_trend.png'
plt.savefig(plot_filename)
plt.close()

# Declare result var
result = { "type": "plot", "value": plot_filename }
